# NASLOP (analytics-api) configuration — copy to .env and fill in secrets (.env is gitignored).
NASLOP_SQLITE_PATH=data/nasa_farming.db
NASLOP_DUCKDB_PATH=data/nasa_farming.duckdb
NASLOP_HOST=127.0.0.1
NASLOP_PORT=8000
NASLOP_DEBUG=True

# Google Gemini advisory. Leave GEMINI_API_KEY blank to use the deterministic offline fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
