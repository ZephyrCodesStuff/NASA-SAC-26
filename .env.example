# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# NASA Earthdata Login (https://urs.earthdata.nasa.gov) — used by the data-api service.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Google Gemini (analytics-api advisory). Leave blank for the deterministic offline fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
